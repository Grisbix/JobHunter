# ── SECRETS — NEVER commit ──
.env
Scripts/.ats_password
Scripts/apply_profile.json
Scripts/mail_config.json
Scripts/gmail_client.json
Scripts/gmail_token.json
Scripts/.pw_chrome_profile/
*cookies*.json
*google_state*.json
Scripts/.sf_profiles/
Scripts/sf_login.png
Scripts/mail_confirmations.json

# ── reversible bin + caches ──
_CORBEILLE_*/
__pycache__/
*.pyc
node_modules/

# ── regenerable artifacts ──
# Where the last Indeed pass stopped in the list of (keyword, city)
# pairs. LOCAL state of one machine: committing it would restart
# the rotation from a point unrelated to the machine.
Scripts/.indeed_rotation
Scripts/_dbg.js
*.log
Scripts/apply_selection.json

# pipeline logs (regenerable)
Scripts/_logs/

# CSV exports + notification state (regenerable)
Scripts/_exports/
Scripts/_notified.json

# deleted offers (local backup, not versioned)
Scripts/_supprimees_*.json
Scripts/_vie_offres.json

# France Travail API credentials (secret)
Scripts/francetravail.json

# API keys (secrets)
Scripts/api_keys.json

Scripts/_workday.json
Scripts/*.lock
Scripts/_test_lock.json*
Scripts/_supprimees_liens_morts_*.json
Scripts/_encore_vivants.json
Scripts/_archives/
Scripts/.pw_chrome_profile/
Scripts/.pytest_cache/

# state of LinkedIn checks + backup of removed offers (regenerable)
Scripts/_linkedin_etat.json
Scripts/_supprimees_linkedin_*.json
Scripts/_ats_candidats.json
apply_queue.json.avant_tri_*

# ── generated documents (moved out of OneDrive) ──
# 760 MB of CVs and letters that regenere_docs.py can rebuild.
# Tracked until 20/09/2026; .git alone then weighed 960 MB.
CV/Par_offre/
Lettres/Par_offre/
Scripts/chemins.json

# ── generated data: out of git since 23/09/2026 ──
# Versioned until then, they were the de facto backup of the queue. But
# each data commit mixed with the code, and the generated documents tracked
# until 20/09 weighed 768 MB of history on their own. The backup is
# now made by pipeline_quotidien.py in Scripts/_sauvegardes/<date>/,
# seven rolling days. suivi.json STAYS tracked: 2.5 KB, and the only data
# that no scan can rebuild.
Scripts/apply_queue.json
Scripts/descriptions.json
Scripts/offres_scan.json
Scripts/offres_fraiches.json
Obsidian/veille_jobs_auto.xlsx
Scripts/_sauvegardes/
CV/_Archives/
Lettres/_Archives/

# state of the availability audit (local, regenerable)
Scripts/_audit_dispo.json

# aggregator API keys (secret)
Scripts/adzuna.json
Scripts/jooble.json
Scripts/_site_final.json
Scripts/_rejets_tri.json

# ── the user's PERSONAL DATA (shared version) ──
# The data folder stays LOCAL; these lines prevent an accidental push from publishing a CV.
profil/profil.json
profil/*.bak
CV/
Lettres/
Scripts/apply_queue.json
Scripts/descriptions.json
Scripts/suivi.json
Scripts/offres_scan.json
Scripts/offres_fraiches.json
Scripts/_sauvegardes/
Scripts/_rejets_tri.json
Scripts/_audit_dispo.json
Scripts/adzuna.json
Scripts/jooble.json

# CV dropped by the user
Mon_CV/*
!Mon_CV/LISEZ-MOI.txt

# Update
.maj_manifeste.json
_sauvegarde_maj/
*.nouveau
.maj_derniere_verif
.maj_git_avant

# Development (uv, pytest, ruff)
.venv/
.pytest_cache/
.ruff_cache/
.coverage
# screenshots taken after sending (proof, ADR 0009): personal data
Scripts/_preuves/
# source yield log (one line per collection)
Scripts/_rendement.jsonl
# ranking evaluation reference (personal judgements)
Scripts/_evaluation.json

# Standalone application (outils/installateur/construire.py)
/dist/
/outils/installateur/build/
